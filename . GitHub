name: Build APK
on: [push]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - name: Build
        run: |
          unzip -o Cinesuivi.zip
          find. -type f -name "ic_launcher*" | head -20
          ls Cinesuivi/app/src/main/res/ -R | head -100
          D=$(find. -name "build.gradle" | grep app | head -1 | xargs dirname | xargs dirname); if [ -z "$D" ]; then D=Cinesuivi; fi; echo "DIR=$D"
          echo '{"project_info":{"project_number":"123","project_id":"d","storage_bucket":"d.appspot.com"},"client":[{"client_info":{"mobilesdk_app_id":"1:123:android:abc","android_client_info":{"package_name":"com.cinesuivi"}},"oauth_client":[],"api_key":[{"current_key":"AIzaDummy"}],"services":{}}],"configuration_version":"1"}' > $D/app/google-services.json
          cd $D
          chmod +x gradlew
         ./gradlew assembleDebug --stacktrace
      - uses: actions/upload-artifact@v4
        with:
          name: Cinesuivi-APK
          path: "**/app/build/outputs/apk/debug/*.apk"
